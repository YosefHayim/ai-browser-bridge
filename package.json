{
  "name": "ai-browser-bridge",
  "version": "0.7.7",
  "description": "Drive ChatGPT, Gemini, Claude, DeepSeek, Grok, Perplexity, Duck.ai, Arena, Google Flow, or Claude Design in Chrome from the terminal — one provider or fan out across several — for humans and agents. ChatGPT can use sandboxed local repo tools via MCP.",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "bin": {
    "bridge": "./dist/bridge.js"
  },
  "files": [
    "dist",
    "SKILL.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YosefHayim/ai-browser-bridge.git"
  },
  "homepage": "https://github.com/YosefHayim/ai-browser-bridge#readme",
  "bugs": {
    "url": "https://github.com/YosefHayim/ai-browser-bridge/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "husky",
    "prepack": "npm run build",
    "prod": "pnpm build && node dist/bridge.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && knip",
    "lint:fix": "biome check --write ./",
    "check": "turbo run lint typecheck test build --output-logs=errors-only"
  },
  "keywords": [
    "chatgpt",
    "mcp",
    "cli",
    "browser-automation",
    "playwright",
    "ink",
    "cloudflare-tunnel",
    "terminal"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "commander": "15.1.0",
    "ink": "8.0.0",
    "ink-text-input": "6.0.0",
    "playwright": "1.65.0",
    "react": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "husky": "9.1.7",
    "knip": "6.44.2",
    "tsup": "9.0.0",
    "turbo": "2.11.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.1.0"
  }
}
