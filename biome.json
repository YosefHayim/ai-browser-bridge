{
  "root": true,
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!**/node_modules",
      "!!**/.bridge",
      "!!**/downloads",
      "!!**/assets",
      "!**/pnpm-lock.yaml"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "linter": { "rules": { "style": { "noDefaultExport": "error" } } },
  "overrides": [
    {
      "includes": ["tsup.config.ts", "vitest.config.ts"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    }
  ]
}
